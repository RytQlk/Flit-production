# ==========================================
# General Application Settings
# ==========================================
PROJECT_NAME=Aquila
UI_LOGO_URL=https://example.com/logo.png

# Generate strong unique values before deployment.
# Example:
# python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# ==========================================
# Gateway LiteLLM Runtime
# ==========================================
LITELLM_VERSION=1.98.0
# Optional SHA-256 of the LiteLLM Python wheel for the selected version.
# Leave blank for local testing without package hash verification.
LITELLM_PACKAGE_SHA256=

# ==========================================
# Optional Presidio services
# ==========================================
# These values are used only with
# overlays/docker-compose.presidio.yml.
PRESIDIO_IMAGE_TAG=2.2.362
PRESIDIO_ANALYZER_IMAGE_DIGEST=sha256:286e3fa7f3a7426e775e8564fe1870f1ba8f999d3ab8bbb8cc46a44355d9d6e9
PRESIDIO_ANONYMIZER_IMAGE_DIGEST=sha256:a10a12a2a613d13cf29d3ad3641e3258444dd8c90403dd644a0a114c472c2483

# ==========================================
# Migration Execution Policies
# ==========================================
PRISMA_MIGRATION_MODE=off
MIGRATION_EXECUTION_MODE=migrate
MIGRATION_FAILURE_POLICY=fail
PRISMA_ALLOW_DATA_LOSS=false
PRISMA_USE_V2_MIGRATION_RESOLVER=false

# ==========================================
# PostgreSQL Database Settings
# ==========================================
# For bundled Docker Postgres, keep POSTGRES_HOST=db.
# For managed Postgres, set POSTGRES_HOST to the managed endpoint and update credentials.
POSTGRES_HOST=db
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=aquila_db
POSTGRES_VOLUME_NAME=aquila_pgdata

# ==========================================
# Redis / DualCache Settings
# ==========================================
# Leave REDIS_URL empty to render the bundled Docker Redis URL from component values.
# For managed Redis, set the full URL, for example:
# REDIS_URL=rediss://username:password@managed.example:6380/0
REDIS_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SCHEME=redis
REDIS_VOLUME_NAME=aquila_redisdata
WEB_REDIS_CONNECT_TIMEOUT_SECONDS=2
WEB_REDIS_COMMAND_TIMEOUT_SECONDS=2
WEB_REDIS_MAX_CONNECTIONS=5

# ==========================================
# Classifier Runtime
# ==========================================
AQUILA_CLASSIFIER_REFRESH_INTERVAL_SECONDS=30
# Optional override for the private classifier identity.
# Normally leave blank: Aquila derives a stable reserved token from the
# LiteLLM master key and provisions/updates its native accounting record when
# an LLM-backed classifier is saved. Never use an end-user or team key.
AQUILA_CLASSIFIER_LLM_VIRTUAL_KEY=

# ==========================================
# Microsoft SSO Settings
# ==========================================
# Leave these blank to use local login only.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:4000/auth/sso/callback
MICROSOFT_POST_LOGIN_REDIRECT_URL=http://localhost:4000/chat
MICROSOFT_TOKEN_REFRESH_BUFFER_SECONDS=120
SESSION_TTL_SECONDS=86400
SSO_COOKIE_SECURE=false

# ==========================================
# RAG Settings
# ==========================================
RAG_ENABLED=false
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=
AZURE_SEARCH_API_VERSION=2026-05-01-preview
RAG_MIN_SCORE=0.5
RAG_TOP_K=5
RAG_TIMEOUT_SECONDS=15
RAG_RETRY_ATTEMPTS=4
RAG_FAILURE_MODE=bypass

# ==========================================
# Web & Gateway Runtime
# ==========================================
WEB_WORKERS=2
WEB_DB_POOL_MIN_SIZE=1
WEB_DB_POOL_MAX_SIZE=5
WEB_FORWARDED_ALLOW_IPS=*
GATEWAY_WORKERS=2
STORE_MODEL_IN_DB=True
CUSTOM_MODEL_COST_MAP_PATH=/app/custom-model-costs.json
CUSTOM_MODEL_COST_MAP_URL=

# 32-byte urlsafe base64 Fernet key.
# Example:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AQUILA_COOKIE_ENCRYPTION_KEY=

# ==========================================
# Aquila Local Authentication
# ==========================================
# Required only when aquila-migrate initializes an empty Aquila schema.
AQUILA_BOOTSTRAP_ADMIN_USERNAME=admin
AQUILA_BOOTSTRAP_ADMIN_PASSWORD=
AQUILA_MINIMUM_PASSWORD_LENGTH=12
AQUILA_LOGIN_LOCKOUT_FAILURES=5
AQUILA_LOGIN_LOCKOUT_SECONDS=900
# Preferred Entra admin bindings: comma-separated <tenant-id>:<object-id> values.
AQUILA_ENTRA_ADMIN_IDENTITIES=
# Optional first-login bootstrap bindings only; stable identities are preferred.
AQUILA_ENTRA_ADMIN_EMAILS=

# ==========================================
# Production Nginx TLS Overlay
# ==========================================
# Directory containing tls.crt and tls.key when using the TLS compose overlay.
NGINX_TLS_DIR=./tls
